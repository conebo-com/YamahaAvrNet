<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net48</TargetFramework>
    <AssemblyName>YamahaAvrNet</AssemblyName>
    <RootNamespace>YamahaAvrNet</RootNamespace>
    <LangVersion>7.3</LangVersion>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);1591</NoWarn>
    <EnableDefaultItems>false</EnableDefaultItems>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="*.cs" />
    <Compile Include="Connections/**/*.cs" />
    <Compile Include="Diagnostics/**/*.cs" />
    <Compile Include="Discovery/**/*.cs" />
    <Compile Include="Exceptions/**/*.cs" />
    <Compile Include="Features/**/*.cs" />
    <Compile Include="Models/**/*.cs" />
    <Compile Include="Monitoring/**/*.cs" />
    <Compile Include="Profiles/**/*.cs" />
    <Compile Include="Protocols/**/*.cs" />
    <Compile Include="PublicApi/**/*.cs" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="AvrNet.Abstractions/AvrNet.Abstractions.csproj" />
  </ItemGroup>
</Project>
