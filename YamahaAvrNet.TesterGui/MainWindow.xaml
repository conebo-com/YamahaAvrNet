<Window x:Class="YamahaAvrNet.TesterGui.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Yamaha AVR Tester" Height="800" Width="1240"
        MinWidth="920" MinHeight="640" Closing="Window_Closing">
    <!-- Same command-browser / three-output structure as the DenonMarantz manual tester. -->
    <Grid Margin="8">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <StackPanel Grid.Row="0" Margin="0,0,0,8">
            <WrapPanel VerticalAlignment="Center">
                <TextBlock x:Name="LblHost" Text="Host:" VerticalAlignment="Center" Margin="0,0,6,0"/>
                <TextBox x:Name="TxtHost" Width="165" VerticalAlignment="Center"
                         ToolTip="Receiver IP address or hostname"/>
                <TextBlock x:Name="LblHttpPort" Text="HTTP port:" Margin="10,0,6,0" VerticalAlignment="Center"/>
                <TextBox x:Name="TxtPort" Text="80" Width="48" VerticalAlignment="Center"/>
                <Button x:Name="BtnConnect" Content="Connect" Padding="10,3" Margin="8,0,0,0"
                        Click="BtnConnect_Click" Focusable="False"/>
                <Button x:Name="BtnRefresh" Content="Refresh" Padding="10,3" Margin="5,0,0,0"
                        Click="BtnRefresh_Click" IsEnabled="False" Focusable="False"/>
                <Button x:Name="BtnDisconnect" Content="Disconnect" Padding="10,3" Margin="5,0,0,0"
                        Click="BtnDisconnect_Click" IsEnabled="False" Focusable="False"/>
                <Button x:Name="BtnOpenWebPage" Content="Receiver web page" Padding="10,3"
                        Margin="10,0,0,0" Click="BtnOpenWebPage_Click" Focusable="False"/>
                <TextBlock x:Name="LblLanguage" Text="Language:" VerticalAlignment="Center"
                           Margin="12,0,6,0"/>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <ToggleButton x:Name="TglEnglish" Content="EN" Width="37" Padding="4,2"
                                  ToolTip="English" IsChecked="True" Click="TglEnglish_Click"/>
                    <ToggleButton x:Name="TglGerman" Content="DE" Width="37" Padding="4,2"
                                  Margin="3,0,0,0" ToolTip="Deutsch" Click="TglGerman_Click"/>
                </StackPanel>
            </WrapPanel>
            <WrapPanel Margin="0,6,0,0" VerticalAlignment="Center">
                <TextBlock x:Name="LblYncaPort" Text="YNCA TCP port:" VerticalAlignment="Center" Margin="0,0,6,0"/>
                <TextBox x:Name="TxtYncaPort" Text="50000" Width="65" VerticalAlignment="Center"/>
                <Button x:Name="BtnYncaConnect" Content="Connect YNCA" Padding="10,3" Margin="8,0,0,0"
                        Click="BtnYncaConnect_Click" IsEnabled="False" Focusable="False"/>
                <Button x:Name="BtnYncaDisconnect" Content="Disconnect YNCA" Padding="10,3" Margin="5,0,0,0"
                        Click="BtnYncaDisconnect_Click" IsEnabled="False" Focusable="False"/>
                <TextBlock x:Name="TxtConnectionStatus" Text="Not connected" FontWeight="Bold"
                           Margin="14,0,0,0" VerticalAlignment="Center"/>
            </WrapPanel>
        </StackPanel>
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="340" MinWidth="260"/>
                <ColumnDefinition Width="6"/>
                <ColumnDefinition Width="*" MinWidth="350"/>
            </Grid.ColumnDefinitions>
            <Grid Grid.Column="0" Margin="0,0,2,0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <DockPanel Grid.Row="0" Margin="0,0,0,5">
                    <Button x:Name="BtnClearSearch" Content="×" Width="26" Height="24" DockPanel.Dock="Right"
                            Click="BtnClearSearch_Click" ToolTip="Clear command search"/>
                    <TextBox x:Name="TxtCommandSearch" Height="24" Margin="0,0,5,0"
                             TextChanged="TxtCommandSearch_TextChanged" ToolTip="Filter commands"/>
                </DockPanel>
                <Border Grid.Row="1" BorderBrush="Gray" BorderThickness="1">
                    <ListBox x:Name="LstCommands" SelectionChanged="LstCommands_SelectionChanged"
                             MouseDoubleClick="LstCommands_MouseDoubleClick">
                        <ListBox.GroupStyle>
                            <GroupStyle>
                                <GroupStyle.HeaderTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding Name}" FontWeight="Bold" Background="#E8EBEF" Padding="4,3"/>
                                    </DataTemplate>
                                </GroupStyle.HeaderTemplate>
                            </GroupStyle>
                        </ListBox.GroupStyle>
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding Name}" Margin="12,1,0,1" TextTrimming="CharacterEllipsis"
                                           ToolTip="{Binding Name}"/>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Border>
                <StackPanel Grid.Row="2" Margin="0,8,0,0">
                    <TextBlock x:Name="LblPattern" Text="Speaker pattern number:" Visibility="Collapsed"/>
                    <TextBox x:Name="TxtPattern" Text="1" Margin="0,2,0,4" Visibility="Collapsed"/>
                    <TextBlock x:Name="LblWriteValue" Text="Target value (e.g. -36.5, On, AUDIO1):"
                               Visibility="Collapsed"/>
                    <TextBox x:Name="TxtWriteValue" Margin="0,2,0,4" Visibility="Collapsed"/>
                    <TextBlock x:Name="LblZone" Text="Zone ID (main, zone2, zone3, zone4):" Visibility="Collapsed"/>
                    <TextBox x:Name="TxtZone" Text="main" Margin="0,2,0,4" Visibility="Collapsed"/>
                    <TextBlock x:Name="LblYncaSubunit" Text="YNCA subunit (e.g. MAIN):" Visibility="Collapsed"/>
                    <TextBox x:Name="TxtYncaSubunit" Text="MAIN" Margin="0,2,0,4" Visibility="Collapsed"/>
                    <TextBlock x:Name="LblYncaFunction" Text="YNCA function (e.g. VOL):" Visibility="Collapsed"/>
                    <TextBox x:Name="TxtYncaFunction" Text="VOL" Margin="0,2,0,4" Visibility="Collapsed"/>
                    <TextBlock x:Name="TxtCommandHint" TextWrapping="Wrap" Foreground="DimGray"
                               Text="Select a command."/>
                </StackPanel>
                <StackPanel Grid.Row="3" Margin="0,8,0,0">
                    <CheckBox x:Name="ChkEnableVerifiedWrites"
                              Content="Enable limited RX-A3060 speaker writes (reconnect required)"/>
                    <CheckBox x:Name="ChkEnableYncaWrites" Margin="0,5,0,0"
                              Content="Enable YNCA zone writes (reconnect required)"/>
                    <CheckBox x:Name="ChkEnableSoundWrites" Margin="0,5,0,0"
                              Content="Enable sound / scene writes (reconnect required)"/>
                </StackPanel>
                <Button x:Name="BtnSend" Grid.Row="4" Content="Send" Height="30" Margin="0,8,0,0"
                        Click="BtnSend_Click" IsEnabled="False" Focusable="False"/>
            </Grid>
            <GridSplitter Grid.Column="1" Width="6" HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
                          ResizeDirection="Columns" ResizeBehavior="PreviousAndNext" Background="#DBDFE4"/>
            <Grid Grid.Column="2" Margin="6,0,0,0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="2*" MinHeight="80"/>
                    <RowDefinition Height="6"/>
                    <RowDefinition Height="*" MinHeight="70"/>
                    <RowDefinition Height="6"/>
                    <RowDefinition Height="*" MinHeight="70"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <Grid Grid.Row="0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <TextBlock Grid.Row="0" x:Name="LblResult" Text="Result" FontWeight="Bold"/>
                    <TextBox x:Name="TxtResult" Grid.Row="1" IsReadOnly="True" FontFamily="Consolas"
                             TextWrapping="Wrap" AcceptsReturn="True" VerticalScrollBarVisibility="Auto"
                             Margin="0,2,0,4"/>
                </Grid>
                <GridSplitter Grid.Row="1" Height="6" HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
                              ResizeDirection="Rows" ResizeBehavior="PreviousAndNext" Background="#DBDFE4"/>
                <Grid Grid.Row="2">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <TextBlock Grid.Row="0" x:Name="LblHttpOutput" Text="HTTP output (operation summaries)" FontWeight="Bold"/>
                    <TextBox x:Name="TxtHttpOutput" Grid.Row="1" IsReadOnly="True" FontFamily="Consolas"
                             TextWrapping="Wrap" AcceptsReturn="True" VerticalScrollBarVisibility="Auto"
                             Margin="0,2,0,4"/>
                </Grid>
                <GridSplitter Grid.Row="3" Height="6" HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
                              ResizeDirection="Rows" ResizeBehavior="PreviousAndNext" Background="#DBDFE4"/>
                <Grid Grid.Row="4">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <TextBlock Grid.Row="0" x:Name="LblYncaOutput" Text="YNCA / TCP output" FontWeight="Bold"/>
                    <TextBox x:Name="TxtYncaOutput" Grid.Row="1" IsReadOnly="True" FontFamily="Consolas"
                             TextWrapping="Wrap" AcceptsReturn="True" VerticalScrollBarVisibility="Auto"
                             Margin="0,2,0,4" Text="YNCA not connected. Open the shared TCP session to receive status updates."/>
                </Grid>
                <StackPanel Grid.Row="5" Margin="0,5,0,0">
                    <Border Background="#E8F1FB" BorderBrush="#2F6DB5" BorderThickness="1"
                            CornerRadius="4" Padding="9,7" Margin="0,0,0,7">
                        <TextBlock x:Name="TxtReportHint" TextWrapping="Wrap" Foreground="#1F4E8C"
                                   Text="Compatibility report: review a local, read-only discovery snapshot. Nothing is uploaded automatically."/>
                    </Border>
                    <CheckBox x:Name="ChkClearBeforeOperation" Margin="0,0,0,5"
                              Content="Clear outputs before each operation"/>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button x:Name="BtnCompatibility" Content="Compatibility report..."
                                Padding="12,4" FontWeight="Bold" Click="BtnCompatibility_Click"
                                IsEnabled="False"/>
                        <Button x:Name="BtnClear" Content="Clear outputs" Width="116"
                                Margin="7,0,0,0" Click="BtnClear_Click"/>
                    </StackPanel>
                </StackPanel>
            </Grid>
        </Grid>
    </Grid>
</Window>
