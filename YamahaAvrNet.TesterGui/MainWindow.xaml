<Window x:Class="YamahaAvrNet.TesterGui.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="YamahaAvrNet - Tester" Width="1000" Height="670"
        MinWidth="760" MinHeight="520" WindowStartupLocation="CenterScreen"
        Background="#F4F7FA">
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,16">
            <TextBlock Text="YamahaAvrNet" FontSize="30" FontWeight="SemiBold" Foreground="#17324D" />
            <TextBlock Text="Eigenstaendige WPF-Diagnoseoberflaeche | Phase 1"
                       FontSize="14" Foreground="#526579" Margin="0,4,0,0" />
        </StackPanel>

        <Border Grid.Row="1" Background="#E7F0FA" BorderBrush="#BCD1E8"
                BorderThickness="1" CornerRadius="7" Padding="14" Margin="0,0,0,16">
            <StackPanel>
                <TextBlock Text="Status: Nicht verbunden" FontSize="16"
                           FontWeight="SemiBold" Foreground="#214D75" />
                <TextBlock Text="Phase 1 definiert die API und Datenmodelle. Netzwerkprotokolle sind noch nicht implementiert; es werden keine AVR-Befehle gesendet."
                           TextWrapping="Wrap" Margin="0,6,0,0" Foreground="#214D75" />
            </StackPanel>
        </Border>

        <TabControl Grid.Row="2" Background="White">
            <TabItem Header="&#220;berblick">
                <StackPanel Margin="18">
                    <TextBlock Text="API-Grundgeruest bereit" FontSize="19" FontWeight="SemiBold" />
                    <TextBlock x:Name="FrameworkInfoText" Margin="0,12,0,0" />
                    <TextBlock Text="Einzelne Protokollprovider werden ab Phase 2 schrittweise implementiert."
                               TextWrapping="Wrap" Margin="0,18,0,0" />
                </StackPanel>
            </TabItem>
            <TabItem Header="Zonen">
                <TextBlock Margin="18" Text="Zonen, Lautstaerke, Eingangsquellen und Events folgen in spaeteren Phasen."
                           TextWrapping="Wrap" />
            </TabItem>
            <TabItem Header="Lautsprecher">
                <TextBlock Margin="18" Text="Pattern, Pegel, Distanzen und Snapshots sind vorgemerkt, aber noch nicht implementiert."
                           TextWrapping="Wrap" />
            </TabItem>
            <TabItem Header="Diagnose">
                <TextBlock Margin="18" Text="Raw-Protokollanzeige und Support-Export folgen erst mit abgesicherter Kommunikation."
                           TextWrapping="Wrap" />
            </TabItem>
        </TabControl>

        <TextBlock Grid.Row="3" Margin="0,14,0,0" Foreground="#526579"
                   Text="YamahaAvrNet.TesterGui | net48 | Phase 1 | keine AVR-Kommunikation" />
    </Grid>
</Window>
