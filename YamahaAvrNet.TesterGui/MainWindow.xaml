<Window x:Class="YamahaAvrNet.TesterGui.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Yamaha AVR Tester" Height="780" Width="1150"
        MinWidth="850" MinHeight="580" Closing="Window_Closing">
    <!-- Command-list and multi-output layout follows the DenonMarantz tester. -->
    <Grid Margin="8">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,8">
            <TextBlock Text="Host:" VerticalAlignment="Center" Margin="0,0,6,0"/>
            <TextBox x:Name="TxtHost" Width="180" VerticalAlignment="Center"
                     ToolTip="Receiver IP address or hostname"/>
            <TextBlock Text="HTTP port:" Margin="12,0,6,0" VerticalAlignment="Center"/>
            <TextBox x:Name="TxtPort" Text="80" Width="54" VerticalAlignment="Center"/>
            <Button x:Name="BtnConnect" Content="Connect" Width="88" Margin="8,0,0,0"
                    Click="BtnConnect_Click"/>
            <Button x:Name="BtnRefresh" Content="Refresh" Width="78" Margin="6,0,0,0"
                    Click="BtnRefresh_Click" IsEnabled="False"/>
            <Button x:Name="BtnDisconnect" Content="Disconnect" Width="90" Margin="6,0,0,0"
                    Click="BtnDisconnect_Click" IsEnabled="False"/>
            <TextBlock x:Name="TxtConnectionStatus" Text="Not connected"
                       Margin="12,0,0,0" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
        </StackPanel>
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="340"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Grid Grid.Column="0" Margin="0,0,8,0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <Border Grid.Row="0" BorderBrush="Gray" BorderThickness="1">
                    <ListBox x:Name="LstCommands" SelectionChanged="LstCommands_SelectionChanged"
                             MouseDoubleClick="LstCommands_MouseDoubleClick">
                        <ListBox.GroupStyle>
                            <GroupStyle>
                                <GroupStyle.HeaderTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding Name}" FontWeight="Bold"
                                                   Background="LightGray" Padding="4,2"/>
                                    </DataTemplate>
                                </GroupStyle.HeaderTemplate>
                            </GroupStyle>
                        </ListBox.GroupStyle>
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding Name}" Margin="12,0,0,0"/>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Border>
                <StackPanel Grid.Row="1" Margin="0,8,0,0">
                    <TextBlock x:Name="LblPattern" Text="Speaker pattern number:" Visibility="Collapsed"/>
                    <TextBox x:Name="TxtPattern" Text="1" Margin="0,2,0,4" Visibility="Collapsed"/>
                    <TextBlock x:Name="LblWriteValue" Text="Target value (invariant decimal, e.g. 0.5):"
                               Visibility="Collapsed"/>
                    <TextBox x:Name="TxtWriteValue" Margin="0,2,0,4" Visibility="Collapsed"/>
                    <TextBlock x:Name="TxtCommandHint" TextWrapping="Wrap" Foreground="DimGray"
                               Text="Select an operation. All commands are read-only."/>
                </StackPanel>
                <CheckBox Grid.Row="2" x:Name="ChkEnableVerifiedWrites" Margin="0,8,0,0"
                          Content="Enable limited RX-A3060 writes (reconnect required)"
                          />
                <CheckBox Grid.Row="3" x:Name="ChkClearBeforeOperation" Margin="0,8,0,0"
                          Content="Clear outputs before each operation"/>
                <Button x:Name="BtnSend" Grid.Row="4" Content="Send" Height="30"
                        Margin="0,8,0,0" Click="BtnSend_Click" IsEnabled="False"/>
            </Grid>
            <Grid Grid.Column="1">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <TextBlock Grid.Row="0" Text="Result" FontWeight="Bold"/>
                <TextBox x:Name="TxtResult" Grid.Row="1" IsReadOnly="True" FontFamily="Consolas"
                         TextWrapping="Wrap" AcceptsReturn="True" VerticalScrollBarVisibility="Auto"
                         Margin="0,2,0,8"/>
                <TextBlock Grid.Row="2" Text="HTTP output (request summaries)" FontWeight="Bold"/>
                <TextBox x:Name="TxtHttpOutput" Grid.Row="3" IsReadOnly="True" FontFamily="Consolas"
                         TextWrapping="Wrap" AcceptsReturn="True" VerticalScrollBarVisibility="Auto"
                         Margin="0,2,0,8"/>
                <TextBlock Grid.Row="4" Text="YNCA / TCP output" FontWeight="Bold"/>
                <TextBox x:Name="TxtYncaOutput" Grid.Row="5" IsReadOnly="True" FontFamily="Consolas"
                         TextWrapping="Wrap" AcceptsReturn="True" VerticalScrollBarVisibility="Auto"
                         Margin="0,2,0,8" Text="YNCA will be available in a later phase."/>
                <Grid Grid.Row="6" Margin="0,4,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="Read-only by default. Verified writes require opt-in and confirmation."
                               VerticalAlignment="Center" Foreground="DarkSlateGray"
                               TextWrapping="Wrap"/>
                    <Button x:Name="BtnClear" Grid.Column="1" Content="Clear outputs"
                            Width="120" Margin="8,0,0,0" Click="BtnClear_Click"/>
                </Grid>
            </Grid>
        </Grid>
    </Grid>
</Window>
