<Window x:Class="YamahaAvrNet.TesterGui.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="YamahaAvrNet - Tester" Width="1060" Height="740"
        MinWidth="820" MinHeight="560" WindowStartupLocation="CenterScreen"
        Background="#F4F7FA" Closing="Window_Closing">
    <Grid Margin="22">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,14">
            <TextBlock Text="YamahaAvrNet" FontSize="28" FontWeight="SemiBold" Foreground="#17324D" />
            <TextBlock Text="Read-only Extended Control discovery | .NET Framework 4.8"
                       FontSize="13" Foreground="#526579" Margin="0,4,0,0" />
        </StackPanel>

        <Border Grid.Row="1" Background="White" BorderBrush="#D7E2ED"
                BorderThickness="1" CornerRadius="6" Padding="12" Margin="0,0,0,12">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <TextBlock Text="Receiver host" VerticalAlignment="Center" Margin="0,0,8,0" />
                <TextBox x:Name="HostTextBox" Width="205" Height="27" VerticalContentAlignment="Center"
                         ToolTip="Enter an IP address or hostname, without http://" />
                <TextBlock Text="HTTP port" VerticalAlignment="Center" Margin="16,0,8,0" />
                <TextBox x:Name="PortTextBox" Text="80" Width="57" Height="27"
                         VerticalContentAlignment="Center" />
                <Button x:Name="ConnectButton" Content="Connect and discover" Margin="18,0,6,0"
                        Padding="12,5" Click="ConnectButton_Click" />
                <Button x:Name="RefreshButton" Content="Refresh status" Margin="0,0,6,0"
                        Padding="12,5" IsEnabled="False" Click="RefreshButton_Click" />
                <Button x:Name="DisconnectButton" Content="Disconnect" Padding="12,5"
                        IsEnabled="False" Click="DisconnectButton_Click" />
            </StackPanel>
        </Border>

        <Border Grid.Row="2" Background="#E7F0FA" BorderBrush="#BCD1E8"
                BorderThickness="1" CornerRadius="6" Padding="12" Margin="0,0,0,12">
            <StackPanel>
                <TextBlock x:Name="ConnectionStatusText" Text="Disconnected"
                           FontSize="15" FontWeight="SemiBold" Foreground="#214D75" />
                <TextBlock x:Name="MessageText" Text="No receiver requests have been sent. Read-only discovery sends three HTTP GET requests."
                           TextWrapping="Wrap" Margin="0,5,0,0" Foreground="#214D75" />
            </StackPanel>
        </Border>

        <TabControl Grid.Row="3" Background="White">
            <TabItem Header="Overview">
                <Grid Margin="18">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <TextBlock x:Name="ModelText" FontSize="20" FontWeight="SemiBold"
                               Text="No device information" />
                    <TextBlock x:Name="VersionText" Grid.Row="1" Margin="0,12,0,0"
                               Text="Firmware: unknown | Extended Control API: unknown" />
                    <TextBlock x:Name="PatternText" Grid.Row="2" Margin="0,10,0,0"
                               Text="Speaker patterns: unknown | Active pattern: unknown" />
                    <TextBox x:Name="OverviewDetailsText" Grid.Row="3" Margin="0,16,0,0"
                             Text="Dynamic zone information appears after discovery."
                             IsReadOnly="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto"
                             BorderThickness="0" Background="Transparent" />
                </Grid>
            </TabItem>
            <TabItem Header="Zones">
                <DataGrid x:Name="ZonesGrid" Margin="12" AutoGenerateColumns="False"
                          IsReadOnly="True" CanUserAddRows="False" HeadersVisibility="Column"
                          GridLinesVisibility="Horizontal">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Native zone ID" Binding="{Binding NativeId}" Width="*" />
                        <DataGridTextColumn Header="Inputs" Binding="{Binding InputCount}" Width="80" />
                        <DataGridTextColumn Header="Sound programs" Binding="{Binding SoundProgramCount}" Width="120" />
                        <DataGridTextColumn Header="Scenes" Binding="{Binding SceneCount}" Width="80" />
                        <DataGridTextColumn Header="Volume range (dB)" Binding="{Binding VolumeRangeDb}" Width="210" />
                    </DataGrid.Columns>
                </DataGrid>
            </TabItem>
            <TabItem Header="Capabilities">
                <DataGrid x:Name="CapabilitiesGrid" Margin="12" AutoGenerateColumns="False"
                          IsReadOnly="True" CanUserAddRows="False" HeadersVisibility="Column"
                          GridLinesVisibility="Horizontal">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Feature" Binding="{Binding FeatureId}" Width="*" />
                        <DataGridTextColumn Header="Evidence status" Binding="{Binding Status}" Width="150" />
                        <DataGridTextColumn Header="Read" Binding="{Binding CanRead}" Width="80" />
                        <DataGridTextColumn Header="Write" Binding="{Binding CanWrite}" Width="80" />
                        <DataGridTextColumn Header="Source" Binding="{Binding Evidence}" Width="125" />
                    </DataGrid.Columns>
                </DataGrid>
            </TabItem>
            <TabItem Header="Diagnostics">
                <Grid Margin="18">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <TextBlock Text="Read-only HTTP endpoints: getDeviceInfo, getFeatures, getFuncStatus. No PUT requests are available."
                               TextWrapping="Wrap" Margin="0,0,0,12" />
                    <TextBox x:Name="DiagnosticsText" Grid.Row="1" IsReadOnly="True"
                             AcceptsReturn="True" TextWrapping="Wrap"
                             VerticalScrollBarVisibility="Auto" FontFamily="Consolas"
                             Text="Connect to display returned system status keys. Sensitive device identifiers are not shown." />
                </Grid>
            </TabItem>
        </TabControl>

        <TextBlock Grid.Row="4" Margin="0,12,0,0" Foreground="#526579"
                   Text="Extended Control GET only | No automatic writes or background polling" />
    </Grid>
</Window>
